# 14 — a cast in expression position
#
# `$[T] <- e` is a static ascription and yields `e`. In expression position it
# is a cast, not a binding.

n: int;
$n <- 123;

$stdout <- ($[int] <- n);            # 123

either: [T: ?] [U: ?] `either-\(T)-\(U)` => (
	left: [reason: T] `\(reason)`;
	right: [value: U] `\(value)`;
);

$stdout <- ($[either int string] <- left 1);   # 1
