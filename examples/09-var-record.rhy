# 09 — an object with private state
#
# `var` is a record type; `new_var` returns one. `\self (inst)` renames the
# constructor's result variable so the method can reach the instance.
#
# expected output:
#   1000
#   123

var: [value: int] [assign_value: [int]()] `new_var-\(value)-\(assign_value)`;

new_var: [] var => {
	\self (inst);
	$inst.value <- 0;
	$inst.assign_value <- [x:] { $inst.value <- x };
};

replace_and_return_old: [var] int;
$replace_and_return_old <- [v:] {
	$self <- v.value;
	v.assign_value 123;
};

V1: var;
$V1 <- new_var ();
V1.value <- 1000;
\print (replace_and_return_old V1);   # 1000
\print (replace_and_return_old V1);   # 123
