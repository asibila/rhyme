# 09 — an object with private state
#
# `var` is a record type; `new_var` returns one. The constructor fills a named
# result `inst`, so the method can reach the instance. A method is a partial
# application of an ordinary function: `set_var inst` captures the instance.
#
# expected output:
#   1000
#   123

var: [value: int] [assign_value: [x: int] ()] `new_var-\(value)-\(assign_value)`;

set_var: [inst: var] [x: int] () => ... r: {
	$inst.value = x;
	$r = ();
};

new_var: [] var => ... inst: {
	$inst.value = 0;
	$inst.assign_value = set_var inst;
};

replace_and_return_old: [v: var] int => ... r: {
	$r = v.value;
	v.assign_value 123;
};

V1: var;
$V1 = new_var ();
V1.value = 1000;
$stdout = (replace_and_return_old V1);   # 1000
$stdout = (replace_and_return_old V1);   # 123
