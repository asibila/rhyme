# 19 — an object with private state and fresh identity
#
# `counter` is a record type; `new_counter` returns one. `\self (inst)` renames
# the constructor's result so the method can reach the instance.
#
# The display template is the public interface: `num` is a local, not a field.
#
# expected output:
#   0
#   1

counter_id: int;
$counter_id <- 0;

succ: [int] int;
$succ <- [n:] n;                # body: identity outside the table
succ $(0) <- 1;
succ $(1) <- 2;
succ $(2) <- 3;

counter: [id: int] [increment: []] `\(id)\(increment)`;

new_counter: [] counter => {
	\self (inst);
	$inst.id <- counter_id;
	$counter_id <- succ counter_id;

	num: int;
	$num <- 0;

	$inst.increment <- [] { $num <- succ num; };
};

C1: counter;
$C1 <- new_counter ();
C2: counter;
$C2 <- new_counter ();

\print (C1.id);                  # 0
\print (C2.id);                  # 1

C1.increment ();
