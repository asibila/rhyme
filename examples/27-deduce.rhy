# 27 — a call with inferred type parameters
#
# fmap's type variables are inferred from the arguments:
#   R              : rec int     -> C = rec, T = int
#   add_int 1000   : int -> int  -> T = int, U = int

rec: [@T] `` => (
	new_rec: ``;
	unshift_rec: [value: @T] [tail: rec @T] `\(value)-\(tail)`;
);

R: rec int;
$R = new_rec;
$R = unshift_rec 123 R;
$R = unshift_rec 222 R;

fmap: [data: @C @T] [func: [@T] @U] (@C @U);

fmap $(new_rec) $[f: [@T] @U] = new_rec;
fmap $(unshift_rec $[a: @T] $[b: @C @T]) $[f: [@T] @U] =
	unshift_rec (f a) (fmap b f);

RR: rec int;
$RR = fmap R (add_int 1000);

$stdout = RR;                        # 1222-1123-
