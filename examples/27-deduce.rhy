# 27 — a named call with deduced type parameters
#
# `fmap`'s type parameters C, T, U are omitted; they are solved by unifying the
# supplied arguments' types:
#
#   $arg  <- R              R : rec            -> C = rec
#   $func <- add_int 1000   (int -> int)       -> T = int, U = int

rec: [T: ?] `` => (
	new_rec: ``;
	unshift_rec: [value: T] [tail: rec T] `\(value)-\(tail)`;
);

R: rec int;
$R <- new_rec;
$R <- unshift_rec 123 R;
$R <- unshift_rec 222 R;

fmap: [C: [?]?] [T: ?] [U: ?] [arg: C T] [func: [T] U] (C U) => { };

fmap $[rec] $[T:] $[U:] $(new_rec) $(func:) <- new_rec;
fmap $[rec] $[T:] $[U:] $(unshift_rec $[X:] $[Y:]) $(func:) <-
	unshift_rec (func X) (fmap rec T U Y func);

RR: rec int;
$RR <- fmap {
	$arg <- R;
	$func <- add_int 1000;
};

\print (RR);            # 1222-1123-
