# 08 — higher-order functions and mutation
#
# A declaration body needs `=>` before `{`.
# `assign_value` captures `value`, so the call mutates the module's binding.

value: int;
$value <- 0;

assign_value: [int] ();
$assign_value <- [n:] { $value <- n };

apply_123: [F: [int]()] () => { F 123; };
apply_123 assign_value;
\print (value);                  # 123
