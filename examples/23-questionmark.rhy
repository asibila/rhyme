
# 1. map from string to type - example, give type from string

F: [n: string] ?;
$F <- ... void;

F $("bool") <- bool;
F $("int") <- int;
F $("string") <- string;

func_1: [F "bool"] string; # you might use it like this

# 2. take any type - example, format the value
#    print_int/print_float/print_bool return a string; they do not write.

G: [=> ?] string;
$G <- ... "";

G $(int => n:) <- print_int n;
G $(float => n:) <- print_float n;
G $(bool => n:) <- print_bool n;

G 123; # calls print_int (result discarded)
G 23.4; # calls print_float
G "asdf"; # calls default method

# 3. return any type - example, return default value for type

H: [n: string] ?;

$H <- ... void;

H $("int") <- 0;
H $("string") <- "";
H $("bool") <- false;


# 4. take type - example, map type to string

I: [n: ?] string;
$I <- ... "(unknown)";

I $[int] <- "int";
I $[string] <- "string";


# 5. useful example, return key type from container type:

key: [[?] ?] ?;
$key <- ... void;

key $[array] <- int;
key $[dict $[k:]] <- k;
