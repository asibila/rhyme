# 01 — three kinds of dispatch
#
# F takes a *type*  -> parameter [@T], keys $[ ... ]
# G takes an int     -> parameter [x: int], keys $( ... ) / $[X: int]
# H takes any value  -> parameter [X: ?], keys $( ... ) (value shapes)
#
# expected output:
#   "int"
#   "two"
#   "one"

F: [@T] string;
$F <- ... "";
F $[int] <- "int";
F $[string] <- "string";
$stdout <- (F int);                  # int

G: [x: int] string;
$G <- ... "";
G $(1) <- "one";
G $(2) <- "two";
$stdout <- (G 2);                    # two

H: [X: ?] string;
$H <- ... "";
H $(1) <- "one";
$stdout <- (H 1);                    # one

# matching multiple arguments; a type argument and two values
multi: [@A] [b: int] [c: int] string;
$multi <- ... "";

multi ${
	$[int] <- A;
	$[b: int] <- b;
	$[c: int] <- c;
} <- "";
