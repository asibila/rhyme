# 01 — three kinds of dispatch
#
# F takes a *type*  -> keys are $[ ... ]  (the slot's type is ?)
# G takes an int     -> keys are $( ... )  (the slot holds a value)
# H takes a typed pair: `H 1` injects `(int => 1)` before matching.
#
# expected output:
#   int
#   two
#   one

F: [x: ?] string;
$F <- ... "";
F $[int] <- "int";
F $[string] <- "string";
$stdout <- (F int);                  # int

G: [x: int] string;
$G <- ... "";
G $(1) <- "one";
G $(2) <- "two";
$stdout <- (G 2);                    # two

H: [=> ?] string;               # a value together with its type
$H <- ... "";
H $(int => 1) <- "one";
$stdout <- (H 1);                    # one


# matching multiple arguments

multi: [A: ?] [B: int] [C: int] string;

$multi <- ... "";

multi ${
	$[int] <- A;
	$(1) <- B;
	$(2) <- C;
} <- "";

