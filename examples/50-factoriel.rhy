reg_id_counter : int => 0;

fetch_next_reg_id: [] int => ... m: {
	$m = reg_id_counter;
	$reg_id_counter = add reg_id_counter 1;
};

reg: `` => new_reg_data: [id: int] [value: int] `\(id) \(value)`;

new_reg: [] reg => ... new_reg_data (fetch_next_reg_id ()) 0;

assign_reg: [R: reg] [arg: int] => ... m: { $R.value = arg };
cast_reg: [R: reg] int => ... R.value;

R1: reg => new_reg ();

assign_reg R1 123;

$stdout = cast_reg R1;

print: [value: ?] string;
print $[X: int => ?] = print_int X;
print $[X: float => ?] = print_float X;
print $[X: bool => ?] = print_bool X;



