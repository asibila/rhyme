# 26 — generic fmap over rec
#
# The type variables are inferred from the value arguments:
#   data : @C @T   -> C = rec, T = int
#   func : [@T] @U  -> U = int / string
#
# The container is selected by the value shape:
#   $(new_rec) and $(unshift_rec ...)

rec: [@T] `` => (
	new_rec: ``;
	unshift_rec: [value: @T] [tail: rec @T] `\(value)-\(tail)`;
);

fmap: [data: @C @T] [func: [@T] @U] (@C @U);

fmap $(new_rec) $[f: [@T] @U] = new_rec;
fmap $(unshift_rec $[a: @T] $[b: @C @T]) $[f: [@T] @U] =
	unshift_rec (f a) (fmap b f);

nums: rec int;
$nums = unshift_rec 1 (unshift_rec 2 new_rec);

plus: rec int;
$plus = fmap nums (add 10);
$stdout = plus;                      # 11-12-

words: rec string;
$words = fmap nums to_string;
$stdout = words;                     # "1"-"2"-
