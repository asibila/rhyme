# 07 — scope: assign the nearest binding
#
# Parameters are named and in scope inside the body.
# `$var_1 <- 123` assigns the *parameter*, so the outer var_1 is untouched.
# The result is `self`.

func_1: [var_1: int] int => {
	$var_1 <- 123;
	$self <- 123;
};

var_1: int;
$var_1 <- 222;
\print (func_1 var_1);           # 123
\print (var_1);                  # 222
