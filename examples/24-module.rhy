# 24 — records, methods, and a generic fmap
#
# `counter` is a record type; `new_counter` returns one. Methods are ordinary
# functions declared inside the constructor body, so they close over its state.

counter_id: int;
$counter_id <- 0;

succ: [n: int] int;
$succ <- ... add_int n 1;

counter: [id: int] [increment: [x: unit] ()] [get_num: [x: unit] int] `\(id)\(increment)\(get_num)`;

new_counter: [] counter => ... inst: {
	$inst.id <- counter_id;
	$counter_id <- succ counter_id;

	num: int;
	$num <- 0;

	inc: [x: unit] () => ... r: { $num <- succ num; $r <- (); };
	get: [x: unit] int => ... r: { $r <- num; };

	$inst.increment <- inc;
	$inst.get_num <- get;
};

C1: counter;
$C1 <- new_counter ();
C1.increment ();
C1.increment ();

rec: [T: ?] `` => (
	new_rec: ``;
	unshift_rec: [value: T] [tail: rec T] `\(value)-\(tail)`;
);

R: rec int;
$R <- new_rec;
$R <- unshift_rec 123 R;
$R <- unshift_rec 222 R;

fmap: [C: [?] ?] [T: ?] [U: ?] [arg: C T] [func: [T] U] (C U);

fmap ${
	$[rec] <- C;
	$(new_rec) <- arg;
} <- new_rec;

fmap ${
	$[rec] <- C;
	$(unshift_rec $[X:] $[Y:]) <- arg;
} <- unshift_rec (func X) (fmap rec T U Y func);

RR: rec int;

$RR <- fmap {
	$arg <- R;
	$func <- add_int 1000;
};

func: [m: int] string => ... n: { $n <- "" };

#func_2: int => 123;

func_5: [=> ?] int => ... 0;
func_5 $(int => n:) <- n;

func_6: => ?;
func_6 <- 123;




$stdout <- (C1);
